{
  "expo": {
    "name": "FormaVita",
    "slug": "formavita-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/formavita/brand/formavita-app-icon-1024.png",
    "scheme": "formavita",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.formavita.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Uygulamayı açmak için Face ID kullanılır.",
        "NSUserNotificationsUsageDescription": "Randevu hatırlatmaları için bildirim gönderilir."
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/formavita/brand/formavita-app-icon-1024.png",
          "resizeMode": "contain",
          "backgroundColor": "#EEEBF7"
        }
      ],
      "./plugins/with-local-notifications-only",
      [
        "expo-notifications",
        {
          "icon": "./assets/formavita/brand/formavita-app-icon-1024.png",
          "color": "#6C3CF0",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Uygulamayı açmak için Face ID kullanılır."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportsSQLCipher": false,
      "sqlCipherNote": "Gerçek danışan verisi öncesi development build ile SQLCipher tamamlanmalıdır."
    }
  }
}
